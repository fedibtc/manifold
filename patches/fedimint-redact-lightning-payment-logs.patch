+/// Redact payment authorization, invoice, contract, gateway, and outcome data
+/// from generic state-machine trace diagnostics.
+impl std::fmt::Debug for LightningPayCommon {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("LightningPayCommon")
+            .field("operation_id", &self.operation_id)
+            .field("federation_id", &self.federation_id)
+            .field("gateway_fee", &self.gateway_fee)
+            .finish_non_exhaustive()
+    }
+}
+
+impl std::fmt::Debug for LightningPayStateMachine {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        let state = match self.state {
+            LightningPayStates::CreatedOutgoingLnContract(_) => "created_outgoing_ln_contract",
+            LightningPayStates::FundingRejected => "funding_rejected",
+            LightningPayStates::Funded(_) => "funded",
+            LightningPayStates::Success(_) => "success",
+            #[allow(deprecated)]
+            LightningPayStates::Refundable(_) => "refundable",
+            LightningPayStates::Refund(_) => "refund",
+            #[allow(deprecated)]
+            LightningPayStates::Refunded(_) => "refunded",
+            LightningPayStates::Failure(_) => "failure",
+        };
+        f.debug_struct("LightningPayStateMachine")
+            .field("common", &self.common)
+            .field("state", &state)
+            .finish()
+    }
+}
