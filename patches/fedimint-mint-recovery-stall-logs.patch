+/// Fetches a slice's consensus hash, warning while it stays pending.
+///
+/// The fetch retries until a threshold of peers agree and logs nothing on
+/// the way, so a recovery that waits here would otherwise stall silently.
+async fn fetch_recovery_slice_hash_logged(
+    module_api: DynModuleApi,
+    start: u64,
+    end: u64,
+) -> sha256::Hash {
+    const WARN_INTERVAL: Duration = Duration::from_secs(60);
+
+    let fetch = module_api.fetch_recovery_slice_hash(start, end);
+    pin_mut!(fetch);
+    let mut waited = Duration::ZERO;
+    loop {
+        match tokio::time::timeout(WARN_INTERVAL, &mut fetch).await {
+            Ok(hash) => return hash,
+            Err(_) => {
+                waited += WARN_INTERVAL;
+                warn!(
+                    target: LOG_CLIENT_MODULE_MINT,
+                    start, end,
+                    waited_secs = waited.as_secs(),
+                    "Mint recovery slice hash is still pending"
+                );
+            }
+        }
+    }
+}
