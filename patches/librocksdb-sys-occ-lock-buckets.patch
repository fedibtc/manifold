+  // parallel at low concurrency here, and any count of at least 16 is
+  // correct, so 4096 buckets keep contention negligible at about 160 KiB.
+  uint32_t occ_lock_buckets = (1 << 12);
 
   // A pool of mutex locks for validating transactions. Can be shared among
