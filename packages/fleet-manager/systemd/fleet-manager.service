# Manifold Guardian on a bare-metal Linux host. Installed and updated by
# fleet-manager-setup; see ../bare-metal.md.
[Unit]
Description=Manifold Guardian (fleet-manager)
Documentation=https://github.com/fedibtc/manifold/blob/master/packages/fleet-manager/bare-metal.md
After=network-online.target bitcoind.service
Wants=network-online.target
# The data root may be a bind mount from another disk: never start on an empty directory.
RequiresMountsFor=/nix /opt/fleet-manager /var/lib/fleet-manager

[Service]
User=fleet-manager
Group=fleet-manager
StateDirectory=fleet-manager
StateDirectoryMode=0700
UMask=0077
WorkingDirectory=%S/fleet-manager
Environment=FLEET_MANAGER_DATA_DIR=%S/fleet-manager
# Bitcoin Core RPC, Manifold environment and dashboard bind; root 0600, read by
# systemd before it drops privileges, so the service user cannot read it.
EnvironmentFile=/etc/fleet-manager/fleet-manager.env
# fleet-manager:fleet-manager 0400; the daemon refuses group or other bits.
# (Not LoadCredential=: its ACL shows up as group bits and the daemon refuses it.)
Environment=FLEET_MANAGER_ADMIN_HTTP_PASSWORD_FILE=/etc/fleet-manager/admin-password
# Each release is one commit's daemon plus that commit's own entrypoint.
Environment=PATH=/opt/fleet-manager/current/fleet-manager/bin:/usr/bin:/bin
ExecStart=/opt/fleet-manager/current/entrypoint.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
